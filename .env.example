# ─────────────────────────────────────────────────────────────
# Finding Nibbles — environment configuration
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. All keys below are placeholders.
# ─────────────────────────────────────────────────────────────

# ---- Database ----
# MongoDB connection string (local dev or Atlas)
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="finding-nibbles"

# ---- Auth (NextAuth / Auth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Optional: seed a demo user on first server boot (username/password)
SEED_USERNAME="test"
SEED_PASSWORD="test"

# ---- Google Maps / Places (client-side) ----
# Exposed to the browser — restrict by HTTP referrer in the GCP console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="REPLACE_WITH_GOOGLE_MAPS_API_KEY"

# ---- Google Vertex AI (server-side dish suggestions) ----
GOOGLE_CLOUD_PROJECT="REPLACE_WITH_GCP_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_MODEL="gemini-2.0-flash-001"
AI_TEMPERATURE="0.8"
# Path to a service-account JSON key file, OR paste the JSON inline (one line).
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccount.json"
# Alternatively provide the JSON directly (takes precedence over the path):
# GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# ---- Hugging Face (server-side image generation) ----
HF_TOKEN="REPLACE_WITH_HUGGING_FACE_ACCESS_TOKEN"
