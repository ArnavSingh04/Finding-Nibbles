# ─────────────────────────────────────────────────────────────
# Finding Nibbles — environment configuration
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit `.env` / `.env.local`. Every value below is a placeholder.
# ─────────────────────────────────────────────────────────────

# ---- Database ----
# MongoDB connection string (local dev or Atlas). Do NOT put real hosts here.
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB="finding-nibbles"

# ---- Auth (NextAuth / Auth.js) ----
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"
# In production set this to your real deployed URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional: seed a demo user via `npm run seed`
SEED_USERNAME="test"
SEED_PASSWORD="test"

# ---- Google Maps / Places (client-side) ----
# Exposed to the browser — restrict by HTTP referrer in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="REPLACE_WITH_GOOGLE_MAPS_API_KEY"

# ---- Gemini API (server-side dish suggestions) ----
# Google AI Studio API key: https://aistudio.google.com/apikey
# NOTE: this is the API-KEY product, not Vertex AI (no service account needed).
GEMINI_API_KEY="REPLACE_WITH_GEMINI_API_KEY"
GEMINI_MODEL="gemini-2.0-flash"
AI_TEMPERATURE="0.8"

# ---- Hugging Face (server-side image generation) ----
# Optional — if omitted, image generation falls back to bundled dish images.
HF_TOKEN="REPLACE_WITH_HUGGING_FACE_ACCESS_TOKEN"
